{
  "name": "scatter",
  "version": "5.1.18",
  "description": "A local multimodal canvas that sends structured node flows to Codex.",
  "main": "out/main/index.js",
  "type": "module",
  "private": true,
  "scripts": {
    "predev": "npm run build:accessibility-guide",
    "dev": "electron-vite dev",
    "build:accessibility-guide": "node scripts/build-accessibility-guide.mjs",
    "build:app": "npm run typecheck && electron-vite build",
    "typecheck": "tsc --noEmit",
    "build": "npm run build:accessibility-guide && npm run build:app",
    "preview": "electron-vite preview",
    "pack": "npm run build && electron-builder --dir",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:mac:publish": "npm run build && electron-builder --mac --publish always",
    "dist:win": "npm run build:app && electron-builder --win --x64",
    "dist:win:publish": "npm run build:app && electron-builder --win --x64 --publish always"
  },
  "build": {
    "appId": "com.scatter.desktop",
    "productName": "Scatter",
    "publish": [
      {
        "provider": "github",
        "owner": "Niall-Young",
        "repo": "Scatter",
        "releaseType": "draft"
      }
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/app-icon.png",
        "to": "app-icon.png"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "extendInfo": {
        "NSAppleEventsUsageDescription": "Scatter uses Apple Events to paste and submit prompts in Codex and Terminal when you run a task."
      },
      "icon": "resources/app-icon.icns",
      "identity": "-",
      "extraResources": [
        {
          "from": "build/accessibility-guide/ScatterAccessibilityGuide",
          "to": "accessibility-guide/ScatterAccessibilityGuide"
        }
      ],
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ]
    },
    "win": {
      "icon": "resources/app-icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "perMachine": false
    }
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-switch": "^1.2.6",
    "@xyflow/react": "^12.9.3",
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.3",
    "nanoid": "^5.1.6",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "electron": "^39.2.7",
    "electron-builder": "^26.8.1",
    "electron-vite": "^4.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.6"
  }
}
